[tasks]
bmc
cover

[options]
bmc: mode bmc
cover: mode cover
depth 300
multiclock on

[engines]
bmc: abc bmc3
cover: smtbmc boolector

[script]
read -formal -sv instruction_decoder.v
read -formal -sv timer_counter.v
read -formal -sv bit_transfer_engine.v
read -formal -sv event_engine.v
read -formal -sv vm_sequencer.v
read -formal -sv gpio_arbiter.v
read -formal -sv gpio_datapath.v
read -formal -sv crc_engine.v
read -formal -sv line_pair.v
read -formal -sv protocol_emulator_core.v
read -formal -sv uart_rx_properties.sv
prep -top uart_rx_properties

[files]
../../src/instruction_decoder.v
../../src/timer_counter.v
../../src/bit_transfer_engine.v
../../src/event_engine.v
../../src/vm_sequencer.v
../../src/gpio_arbiter.v
../../src/gpio_datapath.v
../../src/crc_engine.v
../../src/line_pair.v
../../src/protocol_emulator_core.v
uart_rx_properties.sv
