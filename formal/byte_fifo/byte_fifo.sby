[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
prove: mode prove
cover: mode cover
depth 32
multiclock on

[engines]
bmc: abc bmc3
prove: abc pdr
cover: btor btormc

[script]
read -formal -sv byte_fifo.v
read -formal -sv byte_fifo_properties.sv
prep -top byte_fifo_properties

[files]
../../src/byte_fifo.v
byte_fifo_properties.sv
