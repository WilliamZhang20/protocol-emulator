[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
prove: mode prove
cover: mode cover
depth 32
multiclock on

[engines]
bmc: abc bmc3
prove: abc pdr
cover: btor btormc

[script]
read -formal -sv event_engine.v
read -formal -sv event_engine_properties.sv
prep -top event_engine_properties

[files]
../../src/event_engine.v
event_engine_properties.sv
