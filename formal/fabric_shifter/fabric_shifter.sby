[tasks]
bmc tile
cover tile
coder_bmc coder
coder_cover coder
manch_bmc manch
manch_cover manch
link_bmc link
link_cover link
ahead_bmc ahead
ahead_cover ahead

[options]
bmc: mode bmc
cover: mode cover
bmc: depth 24
cover: depth 48
coder_bmc: mode bmc
coder_bmc: depth 30
coder_cover: mode cover
coder_cover: depth 30
manch_bmc: mode bmc
manch_bmc: depth 30
manch_cover: mode cover
manch_cover: depth 40
link_bmc: mode bmc
link_bmc: depth 40
link_cover: mode cover
link_cover: depth 60
ahead_bmc: mode bmc
ahead_bmc: depth 30
ahead_cover: mode cover
ahead_cover: depth 40

[engines]
bmc: smtbmc bitwuzla
cover: btor btormc
coder_bmc: smtbmc bitwuzla
coder_cover: btor btormc
manch_bmc: smtbmc bitwuzla
manch_cover: btor btormc
link_bmc: smtbmc bitwuzla
link_cover: btor btormc
ahead_bmc: smtbmc bitwuzla
ahead_cover: smtbmc bitwuzla

[script]
read -formal -sv config_bank.v
read -formal -sv fabric_shifter.v
tile: read -formal -sv fabric_shifter_properties.sv
tile: prep -top fabric_shifter_properties
coder: read -formal -sv fabric_shifter_coder_properties.sv
coder: prep -top fabric_shifter_coder_properties
manch: read -formal -sv fabric_shifter_manchester_properties.sv
manch: prep -top fabric_shifter_manchester_properties
link: read -formal -sv fabric_shifter_link_properties.sv
link: prep -top fabric_shifter_link_properties
ahead: read -formal -sv fabric_shifter_ahead_properties.sv
ahead: prep -top fabric_shifter_ahead_properties

[files]
../../src/config_bank.v
../../src/fabric_shifter.v
fabric_shifter_properties.sv
fabric_shifter_coder_properties.sv
fabric_shifter_manchester_properties.sv
fabric_shifter_link_properties.sv
fabric_shifter_ahead_properties.sv
