[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
prove: mode prove
cover: mode cover
depth 48
multiclock on

[engines]
bmc: abc bmc3
prove: abc pdr
cover: btor btormc

[script]
read -formal -sv action_engine.v
read -formal -sv action_engine_properties.sv
prep -top action_engine_properties

[files]
../../src/action_engine.v
action_engine_properties.sv
