[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
prove: mode prove
cover: mode cover
depth 3
multiclock on

[engines]
bmc: smtbmc z3
prove: smtbmc z3
cover: smtbmc z3

[script]
read -formal -sv action_dispatcher.v
read -formal -sv action_dispatcher_properties.sv
prep -top action_dispatcher_properties

[files]
../../src/action_dispatcher.v
action_dispatcher_properties.sv
