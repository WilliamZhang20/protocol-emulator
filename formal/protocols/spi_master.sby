[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 90
cover: mode cover
cover: depth 90

[engines]
smtbmc boolector

[script]
read -formal -sv protocol_emulator_core.v px8_controller.v fabric_timer.v fabric_shifter.v fabric_counter.v fabric_crc.v fabric_logic.v byte_tile.v config_bank.v
read -formal -sv spi_master_properties.sv
prep -top spi_master_properties
script prearm.ys

