[tasks]
bmc
cover

[options]
bmc: mode bmc
cover: mode cover
cover: timeout 120
depth 300
multiclock on

[engines]
bmc: abc bmc3
cover: btor btormc

[script]
read -formal -sv instruction_decoder.v
read -formal -sv register_file.v
read -formal -sv timer_counter.v
read -formal -sv serial_shifter.v
read -formal -sv action_dispatcher.v
read -formal -sv action_lane.v
read -formal -sv action_engine.v
read -formal -sv event_engine.v
read -formal -sv vm_sequencer.v
read -formal -sv gpio_arbiter.v
read -formal -sv gpio_datapath.v
read -formal -sv crc_engine.v
read -formal -sv protocol_emulator_core.v
read -formal -sv uart_tx_properties.sv
prep -top uart_tx_properties

[files]
../../src/instruction_decoder.v
../../src/register_file.v
../../src/timer_counter.v
../../src/serial_shifter.v
../../src/action_dispatcher.v
../../src/action_lane.v
../../src/action_engine.v
../../src/event_engine.v
../../src/vm_sequencer.v
../../src/gpio_arbiter.v
../../src/gpio_datapath.v
../../src/crc_engine.v
../../src/protocol_emulator_core.v
uart_tx_properties.sv
